NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put the service-role key in a NEXT_PUBLIC_ variable or in client code.
# Server-only public origin used for magic-link redirects (e.g. https://fleet.example.com).
# If unset, it is derived from x-forwarded-host/host (never from the Origin header).
SITE_URL=
